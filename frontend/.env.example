# Production (Vercel): cloud project URL + anon key + live API URL.
# Local: Vite loads .env.local over .env. Use http://127.0.0.1:54321 after `supabase start`.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_API_URL=https://YOUR_RENDER_SERVICE.onrender.com
