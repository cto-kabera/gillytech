# Production (Render): cloud Supabase URL + service role. Set FRONTEND_ORIGIN to the Vercel URL.
# Local: copy to .env.local (overrides .env). After `supabase start`, use `supabase status -o env`.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
FRONTEND_ORIGIN=https://gillytech.vercel.app
PORT=3001
